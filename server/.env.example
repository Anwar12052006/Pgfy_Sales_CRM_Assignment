# ===================================================================
# PGfy Sales CRM — Server Environment Variables Template
# ===================================================================
# Copy this file to "server/.env" and fill in your actual values.
# NEVER commit real .env files to version control.
# ===================================================================

NODE_ENV=development
PORT=5000

# PostgreSQL Connection
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/pgfy_sales_crm?schema=public

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_me_to_a_random_secure_string
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
